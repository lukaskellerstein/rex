{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Agent",
      "Artifact",
      "AskUserQuestion",
      "Bash",
      "BashOutput",
      "Edit",
      "EnterPlanMode",
      "ExitPlanMode",
      "Glob",
      "Grep",
      "KillShell",
      "ListMcpResourcesTool",
      "LSP",
      "mcp__playwright-rex",
      "Monitor",
      "NotebookEdit",
      "Read",
      "ReadMcpResourceTool",
      "ReportFindings",
      "ScheduleWakeup",
      "SendMessage",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Write"
    ],
    "deny": [],
    "ask": [
      "EnterWorktree",
      "ExitWorktree",
      "Read(./secrets/**)",
      "Read(./.secrets/**)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./.npmrc)",
      "Read(./**/*credentials*.json)",
      "Read(./**/serviceAccountKey.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.agekey)",
      "Read(./**/keys.txt)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-session-start.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__playwright-rex__browser_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-pre.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__playwright-rex__browser_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-post.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-post.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-cleanup.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-remove.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dev-tools-plugin@claude-my-marketplace": true,
    "lsp-typescript@claude-my-marketplace": true
  },
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "./**/.env",
        "./**/*.pem",
        "./**/*.key",
        "./**/*.agekey",
        "./**/keys.txt",
        "./**/*credentials*.json",
        "./**/serviceAccountKey.json"
      ]
    },
    "network": {
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "*playwright-launch.sh*",
      "yabai *",
      "osascript *",
      "open *"
    ]
  }
}
