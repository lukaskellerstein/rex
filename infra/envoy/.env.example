# Copy to `.env` IN THIS DIRECTORY:  cp .env.example .env
# compose reads it automatically when you run `up -d` from here. `.env` is
# gitignored by the repo root; THIS file is tracked and must never carry a real
# value.
#
# NOTHING HERE IS REQUIRED. Every variable has a default in compose.yml, so
# `docker compose up -d` works with no `.env` at all.
#
# THERE IS NO `GATEWAY_ENGINE` HERE. The original in `ai-gateway/envoy` picks one
# of five engines with that word plus a restart. This folder has ONE config,
# config/local.yaml, holding BOTH local engines at once — so the switch is the
# model name in the request, and there is nothing to set here.
#
# THERE IS NO KEY VARIABLE FOR THE GATEWAY ITSELF. `aigw run` authenticates no
# caller at all: anything that can reach 26334 can call it. The key below is what
# the gateway sends UPSTREAM, and a caller never sees it.

# --- Per-request logging --------------------------------------------------------
# `false` by default, and it must never be EMPTY: aigw parses this as a bool flag
# and crash-loops on an empty string before it reads any config.
#
# WITH IT FALSE YOU SEE NOTHING PER-REQUEST — the image is distroless, so the
# access log lands in a file no shell can reach. `true` gives one JSON line per
# request AND a full dump of every prompt and reply. Turn it on while debugging a
# spec 43 route, and turn it off again.
AIGW_DEBUG=false

# --- The upstream key -----------------------------------------------------------
# LEAVE THIS BLANK. It is a personal credential and already reaches every shell
# under ~/Projects from ~/.secrets/secrets.enc.yaml through ~/Projects/.envrc.
# Compose reads the SHELL environment before this file, so a blank line resolves
# to the real value at `up` time and no second plaintext copy is created.
#
# UNSLOTH IS THE ONE LOCAL ENGINE THAT NEEDS A KEY: without it every `unsloth-*`
# alias answers `401 Not authenticated`. LMSTUDIO NEEDS NONE — it accepts any
# string, so config/local.yaml carries a literal for it and the `lms-*` aliases
# are unaffected by this variable.
UNSLOTH_API_KEY=
