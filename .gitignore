# OS
.DS_Store
Thumbs.db

# Editor
*.tmp
*.swp
.vscode/
.idea/

# Logs
*.log

# Node.js
node_modules/
dist/
out/

# `build/` is a Node convention for OUTPUT, but electron-builder uses it for
# INPUT: `buildResources: build` in `electron-builder.yml`, which names
# `build/entitlements.mac.plist` twice. Ignoring the directory means a fresh
# clone cannot package REX — it worked here only because the file sat on disk
# untracked. The contents are still ignored; the entitlements file is not.
#
# `build/*` and not `build/`, because git never descends into an excluded
# DIRECTORY, so a `!` under one has no effect. This is the one pattern that
# fails silently and looks correct.
build/*
!build/entitlements.mac.plist
# The app icon. electron-builder picks `build/icon.png` up automatically from
# `buildResources` and generates the .ico and .icns from it. Without it every
# platform ships the default Electron icon — which is what REX did until
# 2026-09-07, when a Windows install produced a shortcut nobody would recognise.
!build/icon.png
# The Windows installer's "already installed" page (Reinstall or Uninstall).

# electron-vite / vite
.vite/

# electron-builder output published to GitHub Releases, not committed
release/
releases/

# Native module rebuild artifacts. better-sqlite3 is compiled per Electron ABI
# by electron-rebuild (SPEC.md §3.2), so the .node binary is machine-specific.
*.node
prebuilds/

# REX stores its database at ~/.rex/rex.db — outside every repository, so it can
# never be committed by accident (SPEC.md §9). This entry only catches a stray
# local one; it is not where the real database lives.
.rex/

# Playwright MCP session artifacts (console logs, snapshots)
.playwright-mcp/

# Bytecode cache from the Python hooks in .claude/hooks/ and from both packages
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Each Python package's virtualenv (spec 42 §12, spec 46 §10). Rebuilt by
# `uv sync`, and machine-specific: the interpreter inside is one `uv` downloaded.
# `local-gateway/.venv` is 456 MB, because `litellm[proxy]` is.
#
# NOT ignored, and deliberately: both `uv.lock` files, `agent-runner/schema.json`,
# `agent-runner/catalogue.json` and the generated `src/shared/agent-protocol.ts`.
# The last three are what `test/protocol.spec.ts` compares against, so an ignored
# one would turn the drift guard into a test that always passes.
agent-runner/.venv/
local-gateway/.venv/

# Machine-local Claude Code overrides. Also covered by a global ignore on this
# machine, but that does not travel with a clone — keep it here too.
.claude/settings.local.json

# Secrets — never committed. Runtime config goes in .env (with a committed
# .env.example carrying only the names); credential values belong in
# ~/.secrets/secrets.enc.yaml, outside every repo.
.env
.env.local
.env.*.local
!.env.example
.envrc
*.key
*.pem
*.agekey
keys.txt

# A plaintext credential file is an anti-pattern — gitignored is not protected.
# Listed so an accidental one cannot be staged.
claude_tokens.md
.agent-token

# Test outputs
test_output/

# design-system/ syncs to a Claude Design project. Four kinds of derived state,
# none of it worth versioning:
#   .ds-sync/    the converter scripts, staged from the design-sync skill
#   ds-bundle/   the generated upload bundle — rebuilt from src/ every time
#   .cache/      machine-local grades and the remote anchor
#   learnings/   scratch from a fan-out run, folded into NOTES.md and deleted
# Everything else under .design-sync/ IS committed: config.json, NOTES.md,
# conventions.md and previews/ are the inputs a future sync reuses.
design-system/.ds-sync/
design-system/ds-bundle/
design-system/.design-sync/.cache/
design-system/.design-sync/learnings/
design-system/.design-sync/node_modules

# Spec 46 §13 — built by `npm run bundle:python` and `electron-builder`.
# 806 MB and 1.3 GB; rebuilt from the two pyproject.toml files on demand.
python-dist/
release/

# design/ is the Claude Design working tree for the Settings page. The
# artboards (*.dc.html) and canvas.json ARE the source and stay versioned; the
# seeded page is 2.5 MB of editor payload, re-made from them by seed-canvas.mjs
# on every change, and must never be edited by hand.
design/rex-settings-page.html
