{
  "name": "rex",
  "version": "0.1.0",
  "description": "Review EX \u2014 comment on documents and discuss each comment with an AI agent",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "dev:nohmr": "REX_NO_HMR=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:anchor": "node test/anchor.spec.ts",
    "test:comments": "node --test test/comments.spec.ts",
    "export": "node src/cli/export.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:gate": "node --test test/gate.spec.ts",
    "test:links": "node --test test/links.spec.ts",
    "test:markdown": "node --test test/markdown.spec.ts",
    "test:prompts": "node --test test/prompts.spec.ts",
    "test:targets": "node --test test/targets.spec.ts",
    "test:diff": "node --test test/diff.spec.ts",
    "test:lasso": "node --test test/lasso.spec.ts",
    "test:migrate": "node --test test/migrate.spec.ts",
    "test:models": "node --test test/models.spec.ts",
    "test:debug": "node --test test/debug.spec.ts",
    "test:workspace": "node --test test/workspace.spec.ts",
    "test:workspace-files": "node --test test/workspaceFiles.spec.ts",
    "test:delete-all": "node --test test/deleteAll.spec.ts",
    "test:pptx": "node --test test/pptx.spec.ts",
    "test:pptx-edit": "node --test test/pptxEdit.spec.ts",
    "test:pptx-anchor": "node test/pptxAnchor.spec.ts",
    "test:profiles": "node --test test/profiles.spec.ts",
    "test:runs": "node --test test/runs.spec.ts",
    "test:work": "node --test test/work.spec.ts",
    "test:docx": "node --test test/docx.spec.ts",
    "test:docx-edit": "node --test test/docxEdit.spec.ts",
    "test:pptx-notes": "node --test test/pptxNotes.spec.ts",
    "test:agent-mode": "node --test test/agentMode.spec.ts",
    "test:created": "node --test test/created.spec.ts",
    "test:stray": "node --test test/stray.spec.ts",
    "test:append-targets": "node --test test/appendTargets.spec.ts",
    "test:scope-word": "node --test test/scopeWord.spec.ts",
    "test:model-pick": "node --test test/modelPick.spec.ts",
    "test:paper": "node --test test/paper.spec.ts",
    "test:diagram": "node --test test/diagram.spec.ts",
    "test:find": "node --test test/find.spec.ts",
    "test:hug": "node --test test/hug.spec.ts",
    "test:lane": "node --test test/lane.spec.ts",
    "test:place-line": "node --test test/placeLine.spec.ts",
    "test:tool-rows": "node --test test/toolRows.spec.ts",
    "test:trace": "node --test test/trace.spec.ts",
    "test:service": "node --test test/service.spec.ts",
    "test:bridge": "node --test test/bridge.spec.ts",
    "test:protocol": "node --test test/protocol.spec.ts",
    "test:library": "npm run test:service && npm run test:bridge && npm run test:protocol && (cd agent-gateway && uv run pytest -q)",
    "test:run-stats": "node --test test/runStats.spec.ts",
    "test:aside": "node --test test/aside.spec.ts",
    "test:gateways": "node --test test/gateways.spec.ts",
    "test:choices": "node --test test/choices.spec.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.14",
    "entities": "^8.0.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "katex": "^0.16",
    "mammoth": "^1.12.1",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.17.0",
    "pdfjs-dist": "^6.2.108",
    "pptxtojson": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
