{
  "name": "rex",
  "version": "0.1.0",
  "description": "Review EX — comment on documents and discuss each comment with an AI agent",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:anchor": "node test/anchor.spec.ts",
    "export": "node src/cli/export.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:gate": "node --test test/gate.spec.ts",
    "test:links": "node --test test/links.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.14",
    "markdown-it": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
