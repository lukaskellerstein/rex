{
  "name": "rex",
  "version": "0.1.0",
  "description": "Review EX \u2014 comment on documents and discuss each comment with an AI agent",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:anchor": "node test/anchor.spec.ts",
    "export": "node src/cli/export.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:gate": "node --test test/gate.spec.ts",
    "test:links": "node --test test/links.spec.ts",
    "test:markdown": "node --test test/markdown.spec.ts",
    "test:prompts": "node --test test/prompts.spec.ts",
    "test:targets": "node --test test/targets.spec.ts",
    "test:diff": "node --test test/diff.spec.ts",
    "test:lasso": "node --test test/lasso.spec.ts",
    "test:migrate": "node --test test/migrate.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "better-sqlite3": "^13.0.3",
    "d3-force": "^3.0.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "katex": "^0.16",
    "mammoth": "^1.12.1",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.17.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
